{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "out/main",
    "rootDir": "src/main",
    "tsBuildInfoFile": "out/.tsbuildinfo/main.tsbuildinfo",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/main/**/*.ts"]
}
