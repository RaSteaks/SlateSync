{
  "extendsBaselineCommit": "c7dafa4d972e5eb7be61f00e2b546d6826e70c87",
  "purpose": "Post-baseline IPC additions. This fixture remains separate from baseline/contracts/ipc.json so the historical inventory stays immutable.",
  "requestMethods": {
    "cancelRecognition": { "channel": "cancel-recognition", "args": ["projectId"] },
    "deleteProject": { "channel": "delete-project", "args": ["id"] },
    "renameLibrary": { "channel": "rename-library", "args": ["name"] },
    "checkCompatibleJsonSchema": { "channel": "check-compatible-json-schema", "args": [] },
    "checkVisionOcr": { "channel": "check-vision-ocr", "args": [] },
    "readLogs": { "channel": "logs-read", "args": ["request"] },
    "openLogsDirectory": { "channel": "logs-open-directory", "args": [] },
    "getGlobalSettings": { "channel": "get-global-settings", "args": [] },
    "saveGlobalSettings": { "channel": "save-global-settings", "args": ["request"] },
    "listCustomProviders": { "channel": "list-custom-providers", "args": [] },
    "createCustomProvider": { "channel": "create-custom-provider", "args": ["request"] },
    "updateCustomProvider": { "channel": "update-custom-provider", "args": ["request"] },
    "deleteCustomProvider": { "channel": "delete-custom-provider", "args": ["request"] },
    "probeCustomModels": { "channel": "probe-custom-models", "args": ["request"] },
    "cancelCustomModelProbe": { "channel": "cancel-custom-model-probe", "args": ["request"] }
  },
  "events": {
    "modelProbeProgress": {
      "channel": "model-probe-progress",
      "subscribeMethod": "onModelProbeProgress",
      "unsubscribe": "returned callback",
      "cleanup": "the typed preload returns an idempotent unsubscribe callback"
    }
  }
}
