.env
# Keep local environment variants and credentials out of commits while retaining the safe template.
.env.*
!.env.example
.DS_Store
node_modules/
.venv-paddleocr/
.paddlex-cache/
__pycache__/
*.pyc
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
coverage/
tmp/
bin/
dist/
out/
public/vendor/

# Rebuildable Storybook, Playwright, Vite, and TypeScript validation output.
/storybook-static/
/test-results/
/playwright-report/
/blob-report/
/.vite/
*.tsbuildinfo

# Keep only the reviewed visual baselines and final stable captures visible.
# Intermediate captures remain locally available but must not enter commits.
.codex/refactor/evidence/IP-03-08/visual-contained-run-[1-9]/*.png
.codex/refactor/evidence/IP-03-08/visual-contained-run-1[0-9]/*.png
.codex/refactor/evidence/IP-03-08/visual-contained-run-2[0-4]/*.png
.codex/refactor/evidence/IP-03-08/visual-run-1/*.png
.codex/refactor/evidence/IP-03-08/c02-visual-run-1/*.png
.codex/refactor/evidence/IP-03-08/c02-visual-run-2/*.png
.codex/refactor/evidence/IP-03-08/c02-final-visual-run-1/*.png
.codex/refactor/evidence/IP-03-08/c02-final-visual-run-2/*.png

# Local assistant session exports may contain prompts and absolute machine paths.
session-*.md
SlateSync.code-workspace
.vscode/

# SwiftPM/Xcode outputs and per-user IDE state are reproducible local artifacts.
/.build/
/DerivedData/
# Ignore SwiftPM's Xcode integration cache while leaving future shared package
# configuration (for example mirrors) eligible for version control.
/.swiftpm/xcode/
*.xcuserstate
xcuserdata/
*.xcuserdatad/
*.xccheckout
*.xcscmblueprint
*.moved-aside

# Xcode test, profiling, archive, and debug-symbol products are generated locally.
*.xcresult
*.xcarchive
*.dSYM
*.dSYM.zip
*.profraw
*.profdata
*.gcda
*.gcno

# Local logs, crash reports, and editor backup files are not source artifacts.
*.log
*.crash
*.swp
*.swo
*~

# The premium UI audit is regenerated from the committed premium-ui.json policy.
/premium-audit.json

# Phase Gate raw logs, DerivedData, Archives, and JSON runs are local/CI evidence.
/.codex/gate-results/
