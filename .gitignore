.env
# Keep local environment variants and credentials out of commits while retaining the safe template.
.env.*
!.env.example
.DS_Store
node_modules/
.venv-paddleocr/
.paddlex-cache/
__pycache__/
*.pyc
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
coverage/
tmp/
bin/
dist/
out/
public/vendor/

# Rebuildable Storybook, Playwright, Vite, and TypeScript validation output.
/storybook-static/
/test-results/
/playwright-report/
/blob-report/
/.vite/
*.tsbuildinfo

# Raw validation output belongs under ignored test-results, never in source
# control. Keep only executable baselines and curated Markdown summaries.
/.codex/refactor/baseline/validation/
/.codex/refactor/evidence/**/*visual*/
/.codex/refactor/evidence/**/*visual-stability.json
/.codex/refactor/evidence/**/changed-paths.json
/.codex/refactor/evidence/**/*performance*.json
/.codex/refactor/evidence/**/*smoke.json
/.codex/refactor/evidence/**/electron-rejected-invoke.json
/.codex/refactor/evidence/**/package-content.txt

# Icon Composer exports and copied icon iterations are reproducible. The
# layered package artwork is the single tracked raster source.
/build/* Exports/
/build/icon.png
/assets/slatesync-icon*.png

# Local assistant session exports may contain prompts and absolute machine paths.
session-*.md
SlateSync.code-workspace
.vscode/

# SwiftPM/Xcode outputs and per-user IDE state are reproducible local artifacts.
/.build/
/DerivedData/
# Ignore SwiftPM's Xcode integration cache while leaving future shared package
# configuration (for example mirrors) eligible for version control.
/.swiftpm/xcode/
*.xcuserstate
xcuserdata/
*.xcuserdatad/
*.xccheckout
*.xcscmblueprint
*.moved-aside

# Xcode test, profiling, archive, and debug-symbol products are generated locally.
*.xcresult
*.xcarchive
*.dSYM
*.dSYM.zip
*.profraw
*.profdata
*.gcda
*.gcno

# Local logs, crash reports, and editor backup files are not source artifacts.
*.log
*.crash
*.swp
*.swo
*~

# The premium UI audit is regenerated from the committed premium-ui.json policy.
/premium-audit.json

# Phase Gate raw logs, DerivedData, Archives, and JSON runs are local/CI evidence.
/.codex/gate-results/
