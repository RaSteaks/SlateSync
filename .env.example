# OpenAI 官方 API：支持 gpt-5.6-luna、gpt-5.6-terra、gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter API：支持本项目内全部四个固定模型
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 可选：随 OpenRouter 请求发送的应用标识
OPENROUTER_SITE_URL=http://localhost:4173

# 任意 OpenAI 兼容 API：Key、Base URL 与模型 ID 均为必填
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example/v1
OPENAI_COMPATIBLE_MODEL=your-vision-model

# chat-completions（默认）或 responses
OPENAI_COMPATIBLE_API_MODE=chat-completions

# chat-completions 可选：json_schema、json_object（默认）或 prompt
OPENAI_COMPATIBLE_JSON_MODE=json_object

# 可选：auto、low、high（默认）或 original
OPENAI_COMPATIBLE_IMAGE_DETAIL=high

# 本地服务
HOST=127.0.0.1
PORT=4173

# 生产服务器必须同时配置；本地可信网络可保持为空
SLATESYNC_AUTH_USERNAME=
SLATESYNC_AUTH_PASSWORD=

# 可选：SlateSync 工作流配置文件；相对路径以项目根目录为基准
SLATESYNC_CONFIG_PATH=slatesync.config.json

# 服务端运行参数；通常保持默认值
MAX_BODY_MB=80
SERVER_HEADERS_TIMEOUT_MS=60000
SERVER_REQUEST_TIMEOUT_MS=300000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
SERVER_MAX_REQUESTS_PER_SOCKET=1000
MAX_CONCURRENT_RECOGNITIONS=1
SHUTDOWN_TIMEOUT_MS=300000

# PaddleOCR 证据层：auto（检测到 .venv-paddleocr 时启用）、true 或 false
PADDLEOCR_ENABLED=auto
PADDLEOCR_REQUIRED=false
PADDLEOCR_MODEL_VERSION=PP-OCRv5
PADDLEOCR_LANGUAGE=ch
PADDLEOCR_DEVICE=cpu

# OCR 性能档：balanced（默认，Mobile 检测 + Server 识别）、fast 或 accurate
PADDLEOCR_PROFILE=balanced

# 可选：覆盖性能档中的模型与识别批量；一般无需修改
PADDLEOCR_DETECTION_MODEL=
PADDLEOCR_RECOGNITION_MODEL=
PADDLEOCR_RECOGNITION_BATCH_SIZE=

# 可选：自定义 Python；默认使用项目内 .venv-paddleocr/bin/python
PADDLEOCR_PYTHON=
PADDLEOCR_MIN_CONFIDENCE=0.10

# 0 表示保留全部文本块；大于 0 时会均匀覆盖整页，不会只截掉底部
PADDLEOCR_MAX_BLOCKS_PER_VIEW=0

# auto 按页面视图数量扩展；也可填写明确的毫秒数，最大 60 分钟
PADDLEOCR_TIMEOUT_MS=auto

# 可选：模型权重缓存位置；默认使用项目内、不会提交 Git 的 .paddlex-cache
PADDLE_PDX_CACHE_HOME=
